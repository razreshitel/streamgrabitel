{
  "name": "streamgrab",
  "version": "0.2.0",
  "description": "Open-source video downloader — browser detector + local yt-dlp/ffmpeg helper. A fully open alternative to Video DownloadHelper.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "setup": "node scripts/make-icons.mjs && node scripts/fetch-tools.mjs",
    "icons": "node scripts/make-icons.mjs",
    "fetch-tools": "node scripts/fetch-tools.mjs",
    "install-host": "powershell -ExecutionPolicy Bypass -File scripts/install-host.ps1",
    "uninstall-host": "powershell -ExecutionPolicy Bypass -File scripts/uninstall-host.ps1",
    "gen-key": "node scripts/gen-key.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
